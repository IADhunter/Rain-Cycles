      <RemovePlugins Include="D:\programas\Steam\steamapps\common\Rain World\RainWorld_Data\StreamingAssets\mods\RainCycles\plugins\*.pdb" />
    </ItemGroup>
    <Delete Files="@(RemovePlugins)" />
  </Target>

</Project>